# GhostWires Mk.IV — copy to .env (never commit .env)
# Keys stay on the server; nothing here is shipped to the browser.

# Which AI backend to use: gemini | nim | openrouter | groq
# If unset: gemini when GEMINI_API_KEY is present, otherwise nim when NVIDIA_API_KEY is present, then openrouter, groq.
AI_PROVIDER=nim

# NVIDIA NIM (free developer key from https://build.nvidia.com → "Get API Key", starts with nvapi-)
NVIDIA_API_KEY=
# Verified default (text + vision): meta/llama-3.2-11b-vision-instruct
# NIM_MODEL=meta/llama-3.2-11b-vision-instruct
# NIM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Google Gemini (https://aistudio.google.com/apikey). API_KEY is accepted as an alias.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional extra free paths (OpenAI-compatible)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# AI request timeout (ms). Free tiers can queue; default 180000.
# AI_TIMEOUT_MS=180000

# Server
# PORT=3000
# HOST=0.0.0.0

# DNS: system resolver first, automatic DNS-over-HTTPS fallback if it looks intercepted.
# DNS_MODE=doh            # force DoH
# DNS_SERVERS=1.1.1.1,9.9.9.9
# DOH_URL=https://cloudflare-dns.com/dns-query

# Only for local VPN/TUN "fake-ip" setups (DNS answers in 198.18.0.0/15). Never on shared servers.
# GHOSTWIRES_ALLOW_FAKEIP=1

# Hosted / shared deployments: ignore every server key above, visitors bring their own (BYOK)
# GHOSTWIRES_BYOK_ONLY=1
# Behind a reverse proxy (Render, Fly, NGINX) so rate limits see real client IPs
# TRUST_PROXY=1
